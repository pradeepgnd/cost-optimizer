# Zetaris (data layer) — values from your Zetaris Console; the guide's defaults are examples only
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# Meterless Nightshift (primary AI provider) — from Nightshift's Console
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
# Planner route (domain-risk review). The router alias is acceptable here; it is never a candidate.
METERLESS_MODEL=meterless/auto
# Planner and Critic routes from GET /v1/models: Nemotron routes (07 v4.3). The NVIDIA hackathon proof sits on these two roles.
# Candidates (any lab) come from the pricing snapshots, whose model_id is the route ID. They are an app choice, not a sponsor requirement.
METERLESS_CRITIC_MODEL=your-non-candidate-route-id
# Optional founder override of the open-source candidate. Leave unset: candidates are chosen per feature (docs/17 R3a).
# meterless/auto is never a candidate.
METERLESS_OPEN_MODEL=your-nemotron-route-id
# Optional, comma-separated route IDs that must run with thinking off (a route that returns empty responses with thinking on).
# METERLESS_NO_THINKING_MODELS=your-route-id
# Optional, comma-separated roles that run with thinking off (default: Planner). A role whose thinking exhausts the 1,024-token cap needs it.
# METERLESS_NO_THINKING_ROLES=Planner,Critic
# Optional per-request read timeout in seconds (default 60); a large reasoning model can need longer.
# METERLESS_REQUEST_TIMEOUT_S=120

# Runtime behaviour
SAMPLE_MODE=false
LOG_LEVEL=INFO
MAX_SPEND_USD=25.00

# The NVIDIA API key belongs in Nightshift's Providers tab, never here.

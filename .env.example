# Copy to .env and fill in. Placeholders only here; never commit .env.

# ---------------------------------------------------------------- Zetaris (data layer)
# Values from your Zetaris Console; the guide's defaults are examples only.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
# Which registered price tables a live run reads. Written by scripts/register_sources.py --bindings-output
# (README, Level 2). Relative paths are from the repository root. The UI shows the snapshot it will use.
ZETARIS_BINDINGS_FILE=data/localstack/bindings.json

# ---------------------------------------------------------------- Meterless Nightshift (all inference)
# From Nightshift's Console. The NVIDIA API key belongs in Nightshift's Providers tab, never here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token

# Planner and Critic routes (07 v4.3): the NVIDIA hackathon proof sits on these two roles. Use route IDs from
# GET /v1/models that have a verified billing profile in data/source_examples/routes.selected.json.
# meterless/auto cannot be priced safely and is refused.
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_CRITIC_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Thinking off (comma-separated). Reasoning counts toward the output cap (2,048 tokens for the Nemotron routes); with thinking on, Lightning
# returned empty or cut-off answers, the Critic hit the cap, and Ultra as a candidate hit the cap on a harder
# feature (2026-10-26). An empty value means "no roles", which turns the built-in Planner default off, so set it or
# remove the line. Listing both Nemotron routes also keeps their candidate comparison like for like.
METERLESS_NO_THINKING_ROLES=Planner,Critic
METERLESS_NO_THINKING_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,nvidia/nemotron-3-ultra-550b-a55b
# Per-request read timeout in seconds (default 60); Ultra has needed more.
METERLESS_REQUEST_TIMEOUT_S=150

# Candidates (any lab) are chosen per feature from the routes Nightshift offers; they are an app choice, not a
# sponsor requirement. Optional override of the open-source candidate; leave commented out to let the app choose.
# A route that is not offered or has no price row stops the run.
# METERLESS_OPEN_MODEL=your-open-model-route-id

# ---------------------------------------------------------------- Evidence publisher (live runs)
# Measured results are written back to Zetaris by scripts/serve_source_ingest.py. Without it a live run ends
# `partial` with its evidence kept in the outbox (scripts/retry_evidence.py replays it).
# Generate a throwaway SOURCE_INGEST_TOKEN in the shell for each session; do not store it here.
SOURCE_INGEST_URL=http://127.0.0.1:8766

# ---------------------------------------------------------------- Runtime behaviour
SAMPLE_MODE=false
LOG_LEVEL=INFO
MAX_SPEND_USD=25.00
# Optional run ledgers (SQLite); defaults are runs.db and runs-sample.db in the working directory.
# RUNS_DB=runs.db

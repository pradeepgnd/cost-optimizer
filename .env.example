# Zetaris (data layer) — values from your Zetaris Console; the guide's defaults are examples only
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# Meterless Nightshift (primary AI provider) — from Nightshift's Console
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=meterless/auto
# Pin the actual Nemotron route exposed by GET /v1/models; meterless/auto is not a Nemotron ID
METERLESS_CRITIC_MODEL=your-nemotron-route-id
# Two candidate routes, comma-separated
METERLESS_CANDIDATE_MODELS=route-a,route-b

# Runtime behaviour
SAMPLE_MODE=false
LOG_LEVEL=INFO
MAX_SPEND_USD=25.00

# The NVIDIA API key belongs in Nightshift's Providers tab, never here.

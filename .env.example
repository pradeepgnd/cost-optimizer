# Zetaris (data layer) — values from your Zetaris Console; the guide's defaults are examples only
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# Meterless Nightshift (primary AI provider) — from Nightshift's Console
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
# Planner route (domain-risk review). The router alias is acceptable here; it is never a candidate.
METERLESS_MODEL=meterless/auto
# Critic route from GET /v1/models. It must not be a candidate's route when Nightshift offers another.
# Candidates (frontier, mid-tier, Nemotron) come from the pricing snapshots, whose model_id is the route ID.
METERLESS_CRITIC_MODEL=your-non-candidate-route-id
# The Nemotron route from GET /v1/models: always the open-source candidate, regardless of score.
# meterless/auto is not a Nemotron ID. If unset, the snapshot row marked "required" is used.
METERLESS_OPEN_MODEL=your-nemotron-route-id

# Runtime behaviour
SAMPLE_MODE=false
LOG_LEVEL=INFO
MAX_SPEND_USD=25.00

# The NVIDIA API key belongs in Nightshift's Providers tab, never here.

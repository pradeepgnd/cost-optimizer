# Zetaris (data layer) — values from your Zetaris Console; the guide's defaults are examples only
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=<ZETARIS_API_KEY>

# Meterless Nightshift (primary AI provider) — from Nightshift's Console
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=<METERLESS_RUNTIME_TOKEN>

METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_CRITIC_MODEL=nvidia/nemotron-3-ultra-550b-a55b
METERLESS_NO_THINKING_ROLES=Planner,Critic
METERLESS_NO_THINKING_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,nvidia/nemotron-3-ultra-550b-a55b
METERLESS_REQUEST_TIMEOUT_S=150

# Runtime behaviour
SAMPLE_MODE=false
LOG_LEVEL=INFO
MAX_SPEND_USD=25.00

# The NVIDIA API key belongs in Nightshift's Providers tab, never here.

#Local stack s3
LOCALSTACK_AUTH_TOKEN=<LOCALSTACK_AUTH_TOKEN>
S3_ENDPOINT=http://localhost:4566


ZETARIS_BINDINGS_FILE=data/localstack/openrouter/bindings-cap2048.json
